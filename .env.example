APP_ENV=development
APP_NAME=ai-quant-trader
DATABASE_URL=postgresql+asyncpg://quant:quant@postgres:5432/quant
REDIS_URL=redis://redis:6379/0

TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# Typical defaults shown in current IBKR docs:
# TWS paper: 7947, TWS live: 7946
# IB Gateway paper: 4002, live: 4001
IBKR_HOST=host.docker.internal
IBKR_PORT=7947
IBKR_CLIENT_ID=71
IBKR_ACCOUNT=
IBKR_CONNECT_TIMEOUT_SECONDS=15
IBKR_STALE_DATA_SECONDS=10

# Comma-separated US equity watchlist; empty means no market data lines are opened.
MARKET_DATA_SYMBOLS=
# 1 = realtime, 2 = frozen, 3 = delayed, 4 = delayed flooding.
MARKET_DATA_TYPE=1

MAX_DAILY_LOSS_PCT=1.0
MAX_TOTAL_EXPOSURE_PCT=20.0
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=5.0
MAX_TRADE_RISK_PCT=0.25
MAX_SPREAD_PCT=0.30
