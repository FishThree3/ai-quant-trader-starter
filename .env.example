APP_ENV=development
APP_NAME=ai-quant-trader
DATABASE_URL=postgresql+asyncpg://quant:quant@postgres:5432/quant
REDIS_URL=redis://redis:6379/0

TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# Verify the actual socket port in TWS/Gateway API settings.
# Common defaults: TWS paper 7497 / live 7496; Gateway paper 4002 / live 4001.
# Known live ports and non-DU accounts are refused by this paper-only adapter.
IBKR_HOST=host.docker.internal
IBKR_PORT=7497
IBKR_CLIENT_ID=71
# Leave blank only when TWS exposes exactly one DU paper account.
IBKR_ACCOUNT=
# Hard adapter-level mutation gate (blocks both order placement and cancellation).
# Keep true for diagnostics. A writable connection STILL requires a pre-trade policy.
IBKR_READ_ONLY=true
IBKR_CONNECT_TIMEOUT_SECONDS=15
IBKR_STALE_DATA_SECONDS=10

# Comma-separated US equity watchlist; empty means no market data lines are opened.
MARKET_DATA_SYMBOLS=
# 1 = realtime, 2 = frozen, 3 = delayed, 4 = delayed-frozen.
# Non-realtime data is display-only and cannot authorize orders.
MARKET_DATA_TYPE=1

MAX_DAILY_LOSS_PCT=1.0
MAX_TOTAL_EXPOSURE_PCT=20.0
MAX_OPEN_POSITIONS=3
MAX_POSITION_PCT=5.0
MAX_TRADE_RISK_PCT=0.25
MAX_SPREAD_PCT=0.30

# Shared secret for the trading-control endpoints (/api/system/kill, /pause, /resume).
# Left empty, those mutations are REFUSED outright rather than allowed. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CONTROL_API_TOKEN=
